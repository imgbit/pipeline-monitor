{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo pipeline",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/examples/serve",
      "args": [
        "--warnings",
        "${input:pipeline}"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "GST_PLUGIN_PATH",
          "value": "${workspaceFolder}/build/src"
        },
        {
          "name": "GST_TRACERS",
          "value": "pipeline-monitor(ui-dir=${workspaceFolder}/web)"
        }
      ],
      "externalConsole": false,
      "preLaunchTask": "build",
      "serverReadyAction": {
        "pattern": "pipeline-monitor: (http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "osx": {
        "MIMode": "lldb"
      },
      "linux": {
        "MIMode": "gdb"
      }
    }
  ],
  "inputs": [
    {
      "id": "pipeline",
      "type": "promptString",
      "description": "Pipeline description (gst-launch syntax), empty for the default: video, audio and subtitles. A tee named t gets a branch added and removed every 2 s, posting a warning each time.",
      "default": ""
    }
  ]
}
